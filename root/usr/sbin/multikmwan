#!/bin/sh
# multikmwan - per-client WAN preference + speed ranking on top of GL kmwan.
. /lib/functions.sh
. /lib/functions/network.sh

SPEED_FILE=/tmp/multikmwan.speed
HEALTH_FILE=/tmp/multikmwan.health
GEO_FILE=/tmp/multikmwan.geo
AUTO_FILE=/tmp/multikmwan.autorank
SPEEDHIST_FILE=/tmp/multikmwan.speedhist
WEB_FILE=/tmp/multikmwan.web
WEBSITES_FILE=/tmp/multikmwan.websites
CONTENT_FILE=/tmp/multikmwan.content
# What a running speed/website test is doing right now, for the Status page:
#   kind wan step index total epoch   (removed when the run ends)
PROGRESS_FILE=/tmp/multikmwan.progress
# Persistent 90-day history lives on flash. Kept tiny: one rolled-up row per
# WAN per day, flushed at most hourly, pruned to HIST_DAYS. An in-RAM
# accumulator absorbs the frequent samples so flash is barely touched.
HIST_DIR=/etc/multikmwan
HIST_FILE=$HIST_DIR/history.csv
ACC_FILE=/tmp/multikmwan.acc
STATE_FILE=/tmp/multikmwan.wanstate
HIST_DAYS=90
LOCK=/var/lock/multikmwan.lock
QUALITY_DIR=/tmp/multikmwan-quality
QUALITY_LIB=/usr/share/multikmwan
WANS=""

log() { logger -t multikmwan "$*"; [ -t 1 ] && echo "$*"; }

# progress <speed|web> <wan> <step>: PROG_I/PROG_N (set by the run loop)
# give "link 2 of 3". The file is rewritten at every step and deleted when
# the run ends, so readers treat an old timestamp as a crashed run.
progress() {
	echo "$1 $2 $3 ${PROG_I:-0} ${PROG_N:-0} $(date +%s)" > "$PROGRESS_FILE"
}

# Lock an already-open descriptor, giving up after N seconds. BusyBox flock
# (the one on GL.iNet firmware) has no -w, so the wait is a poll with -n.
#   flock_wait <fd> <seconds> [-s]
flock_wait() {
	local fd="$1" secs="$2" mode="$3" i=0
	while ! flock -n $mode "$fd" 2>/dev/null; do
		i=$((i + 1))
		[ "$i" -lt "$secs" ] || return 1
		sleep 1
	done
}

g() {
	local _v
	config_load multikmwan
	config_get _v global "$1" "$2"
	echo "$_v"
}

TABLE_BASE=$(g table_base 200)
RULE_BASE=$(g rule_base 2000)
RULE_MAX=$((RULE_BASE + 999))

# ---------------------------------------------------------------- wan list
_wan_cb() {
	local s="$1" iface addr_type dev
	config_get addr_type "$s" addr_type 4
	[ "$addr_type" = "4" ] || return 0
	config_get iface "$s" interface
	[ -n "$iface" ] || return 0
	# Keep configured identities even while their devices disappear.
	case " $WANS " in *" $iface "*) return 0 ;; esac
	WANS="$WANS $iface"
}

collect_wans() {
	WANS=""
	config_load kmwan
	config_foreach _wan_cb member
	WANS=$(echo $WANS)
}

wan_dev() { local d; network_get_device d "$1" 2>/dev/null; echo "$d"; }

wan_gw() {
	local dev="$1"
	ip route show table main 2>/dev/null | \
		awk -v d="$dev" '$1=="default" && $4=="dev" && $5==d {print $3; exit}'
	# balance mode puts the WANs in one multipath route instead
	ip route show table main 2>/dev/null | \
		awk -v d="$dev" '$1=="nexthop" && $5==d {print $3; exit}'
}

wan_table() {
	local want="$1" i="$TABLE_BASE" w
	for w in $WANS; do
		[ "$w" = "$want" ] && { echo "$i"; return 0; }
		i=$((i + 1))
	done
	return 1
}

# Backup-only / metered link: never speed-tested, ranked last with ratio 0.
wan_metered() { [ "$(uci -q get multikmwan."$1".metered)" = "1" ]; }

# Disabled in kmwan: not tracked and never routed to. Scheduled tests skip
# such a link silently instead of logging a failed "nodev" result every run.
wan_disabled() { [ "$(uci -q get kmwan."$1".disabled)" = "1" ]; }

wan_up() {
	local dev
	dev=$(wan_dev "$1")
	[ -n "$dev" ] || return 1
	[ -n "$(wan_gw "$dev" | head -1)" ]
}

# ------------------------------------------------------------- table sync
sync_tables() {
	local w dev gw tbl r
	for w in $WANS; do
		tbl=$(wan_table "$w") || continue
		ip route flush table "$tbl" 2>/dev/null
		dev=$(wan_dev "$w")
		[ -n "$dev" ] || continue
		gw=$(wan_gw "$dev" | head -1)
		# No gateway => WAN is down. Leaving the table empty makes the
		# kernel fall through to this client's next preference.
		[ -n "$gw" ] || continue
		ip route show table main 2>/dev/null | grep -vE '^default|^nexthop|^\s' | \
		while read -r r; do
			[ -n "$r" ] && ip route add table "$tbl" $r 2>/dev/null
		done
		ip route add table "$tbl" default via "$gw" dev "$dev" 2>/dev/null
	done
}

# -------------------------------------------------------------- rule sync
flush_rules() {
	local p n=0
	while [ $n -lt 200 ]; do
		p=$(ip rule show 2>/dev/null | awk -F: -v lo="$RULE_BASE" -v hi="$RULE_MAX" \
			'{ pr=$1+0 } pr>=lo && pr<=hi { print pr; exit }')
		[ -n "$p" ] || break
		ip rule del pref "$p" 2>/dev/null || break
		n=$((n + 1))
	done
}

# Non-metered WANs, best first (desc) or worst first (asc), by the same
# ranking "Fastest" mode uses (composite score, or throughput when the
# composite is off). Config order when there is no speed data yet.
_wans_by_speed() {
	local dir="$1" score w
	if [ ! -f "$SPEED_FILE" ]; then collect_wans; echo "$WANS"; return; fi
	rank_sorted "$(g rank_by sum)" | awk '{print $1, $2}' |
		{ if [ "$dir" = "asc" ]; then sort -n; else cat; fi; } |
		while read -r score w; do wan_metered "$w" || printf '%s ' "$w"; done
}

# Metered/backup links first, then everything else as fallback.
_wans_backup_first() {
	local w metered="" rest=""
	collect_wans
	for w in $WANS; do
		if wan_metered "$w"; then metered="$metered $w"; else rest="$rest $w"; fi
	done
	echo "$metered $rest"
}

# Resolve a client's target into an ordered WAN list. "order" uses the
# configured list; the role modes are recomputed each sync, so a "fastest"
# client follows the best line as measurements change.
_client_order() {
	local s="$1" mode
	config_get mode "$s" mode "order"
	case "$mode" in
		fastest) _wans_by_speed desc ;;
		slowest) _wans_by_speed asc ;;
		backup)  _wans_backup_first ;;
		*)       config_get_x "$s" order ;;
	esac
}
config_get_x() { local v; config_get v "$1" "$2" ""; echo "$v"; }

PREF=0
_client_cb() {
	local s="$1" enabled src order w tbl
	config_get_bool enabled "$s" enabled 1
	[ "$enabled" = 1 ] || return 0
	config_get src "$s" src ""
	[ -n "$src" ] || return 0
	order=$(_client_order "$s")
	[ -n "$order" ] || return 0
	for w in $order; do
		tbl=$(wan_table "$w") || continue
		[ "$PREF" -gt 999 ] && return 0
		ip rule add from "$src" lookup "$tbl" pref $((RULE_BASE + PREF)) 2>/dev/null
		PREF=$((PREF + 1))
	done
}

sync_rules() {
	PREF=0
	config_load multikmwan
	config_foreach _client_cb client
}

cmd_sync() {
	local enabled
	# LuCI's Save only stages to /tmp/.uci; make sure what we apply is
	# also what survives a reboot.
	[ -n "$(uci -q changes multikmwan)" ] && uci commit multikmwan
	enabled=$(g enabled 0)
	collect_wans
	flush_rules
	if [ "$enabled" != "1" ]; then
		ip_flush_tables
		return 0
	fi
	sync_tables
	sync_rules
	log "sync complete: wans='$WANS' rules=$PREF"
	return 0
}

ip_flush_tables() {
	local w tbl
	for w in $WANS; do
		tbl=$(wan_table "$w") && ip route flush table "$tbl" 2>/dev/null
	done
}

cmd_flush() {
	collect_wans
	flush_rules
	ip_flush_tables
	log "flushed all multikmwan rules and tables"
}

# ------------------------------------------------------------------ modes
cmd_mode() {
	local m="$1"
	case "$m" in
		failover|balancing) ;;
		"") uci -q get kmwan.global.mode; return 0 ;;
		*) echo "usage: multikmwan mode [failover|balancing]" >&2; return 1 ;;
	esac
	uci set kmwan.global.mode="$m"
	uci commit kmwan
	/etc/init.d/kmwan restart >/dev/null 2>&1
	log "kmwan mode set to $m"
	echo "$m"
}

# ------------------------------------------------------------- speed test
# Only hostnames are kept: signed URL queries, paths and credentials never
# enter the source history. Labels are snapshots, not lookups of today's UCI.
st_host() {
	local host="${1#*://}"
	host="${host%%/*}"; host="${host%%\?*}"; host="${host%%\#*}"; host="${host##*@}"
	printf '%s' "$host" | tr -cd 'A-Za-z0-9.:[\]-' | cut -c1-253
}

st_config() {
	# MK_SERVER=<profile> in the environment overrides the configured server,
	# for one-off runs from the shell: MK_SERVER=facebook multikmwan speedtest
	ST_PROFILE=${MK_SERVER:-$(g active_server '')}
	ST_LABEL='Custom URLs'
	ST_URL_DOWN=''; ST_URL_UP=''
	# A profile's kind is "file" (fixed file or sized endpoint, the default)
	# or "page": the download URL is a web page whose own assets are pulled
	# from its CDN, so the figure is real-content throughput for that site.
	ST_DOWN_KIND=file
	if [ -n "$ST_PROFILE" ] && [ -n "$(uci -q get multikmwan.$ST_PROFILE)" ]; then
		ST_URL_DOWN=$(uci -q get multikmwan.$ST_PROFILE.down_url)
		ST_URL_UP=$(uci -q get multikmwan.$ST_PROFILE.up_url)
		ST_LABEL=$(uci -q get multikmwan.$ST_PROFILE.label)
		[ "$(uci -q get multikmwan.$ST_PROFILE.kind)" = page ] && ST_DOWN_KIND=page
	fi
	[ -n "$ST_URL_DOWN" ] || ST_URL_DOWN=$(g st_down_url 'https://speed.cloudflare.com/__down?bytes={bytes}')
	[ -n "$ST_URL_UP" ] || ST_URL_UP=$(g st_up_url 'https://speed.cloudflare.com/__up')
	ST_HOST_DOWN=$(st_host "$ST_URL_DOWN"); ST_HOST_UP=$(st_host "$ST_URL_UP")
	if [ -z "$ST_PROFILE" ] && [ "$ST_HOST_DOWN" = speed.cloudflare.com ] && [ "$ST_HOST_UP" = speed.cloudflare.com ]; then
		ST_LABEL=Cloudflare
	fi
	ST_LABEL=$(printf '%s' "${ST_LABEL:-$ST_PROFILE}" | tr ',|\r\n' '    ' | cut -c1-100)
	ST_PROFILE=$(printf '%s' "${ST_PROFILE:-inline}" | tr -cd 'A-Za-z0-9_.-' | cut -c1-64)
}

st_report() {
	printf '%s %s %s %s\n' "$1" "$2" "$3" "$4"
	[ -n "$ST_META_FILE" ] || return 0
	printf '%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s\n' \
		"$ST_TEST_EPOCH" "$1" "$2" "$3" "$4" "${ST_KIND:-manual}" \
		"$ST_LABEL" "$ST_PROFILE" "$ST_HOST_DOWN" "$ST_HOST_UP" \
		"${ST_DOWN_STATUS:-not_run}" "${ST_UP_STATUS:-not_run}" >> "$ST_META_FILE"
}

# Asset URLs a page references (scripts, styles, images, fonts, media), one
# per line, first seen first, at most $2. Pages embed many of them JSON-
# escaped ("https:\/\/cdn\/x.js", Facebook even "https:\\\/\\\/") or with
# &amp;, so those forms are normalised before matching.
st_page_assets() {
	sed 's|\\*/|/|g; s|&amp;|\&|g' "$1" |
		grep -oE 'https://[A-Za-z0-9._~:/?#@!$&()*+,;=%-]+\.(js|css|png|jpg|jpeg|gif|webp|svg|woff2?|mp4|webm)(\?[A-Za-z0-9._~:/?#@!$&()*+,;=%-]*)?' |
		awk '!seen[$0]++' | head -n "$2"
}

# Real-content download for a "page" profile: how fast this WAN pulls from
# the site's own CDN, which an ISP-hosted speedtest server cannot show.
# Phase 1 fetches the page and each discovered asset once, in parallel, as a
# browser does on page load. Phase 2 has every stream pull the largest asset
# back to back inside one curl (connection reuse, like a browser) until the
# byte budget is met. Writes d$i/de$i per stream in the fixed-file format so
# st_validate treats both kinds alike; a stream's rate is its bytes over the
# sum of its transfer times.
st_page_download() {
	local dev="$1" page="$2" bytes="$3" streams="$4" to="$5" tmpd="$6"
	local html="$tmpd/page.html" i=0 url best size per reps args j
	curl -sL -4 --max-redirs 5 --proto '=http,https' --proto-redir '=http,https' \
		--interface "$dev" --max-time "$to" -o "$html" "$page" 2>/dev/null
	[ -f "$html" ] && st_page_assets "$html" 12 > "$tmpd/assets" || : > "$tmpd/assets"
	while read -r url; do
		i=$((i + 1))
		(curl -s -4 --proto '=https' --interface "$dev" --max-time "$to" -o /dev/null \
			-w '%{size_download} %{http_code} %{time_total} %{url_effective}\n' \
			"$url" > "$tmpd/a$i" 2>/dev/null) &
	done < "$tmpd/assets"
	wait
	best=$(cat "$tmpd"/a* 2>/dev/null | awk '$2==200 && $1>0 {print $1, $4}' | sort -rn | head -1)
	size=${best%% *}; url=${best#* }
	i=1
	if [ -z "$best" ]; then
		# Nothing usable: report every stream as failed with a telling status.
		while [ "$i" -le "$streams" ]; do
			echo "0 000 0 0 $page" > "$tmpd/d$i"; echo noassets > "$tmpd/de$i"
			i=$((i + 1))
		done
		return 0
	fi
	per=$((bytes / streams))
	reps=$(( (per + size - 1) / size ))
	[ "$reps" -ge 1 ] || reps=1
	[ "$reps" -le 200 ] || reps=200
	args=''; j=0
	while [ "$j" -lt "$reps" ]; do args="$args $url"; j=$((j + 1)); done
	while [ "$i" -le "$streams" ]; do
		(curl -s -4 --proto '=https' --interface "$dev" --max-time "$to" \
			-w '%{stderr}%{size_download} %{http_code} %{time_total} %{url_effective}\n' \
			$args >/dev/null 2>"$tmpd/p$i"; echo "$?" > "$tmpd/de$i"
		 awk '{ b+=$1; t+=$3; if ($2<200 || $2>=300) bad=$2; u=$4 }
			END { if (t<=0) t=1e-9; printf "%.0f %s %d %.3f %s\n", b/t, (bad=="" ? 200 : bad), b, t, u }' \
			"$tmpd/p$i" > "$tmpd/d$i") &
		i=$((i + 1))
	done
	wait
}

# Measures each WAN by binding curl to that WAN's device, so the result is
# that link's throughput regardless of which one the routing table prefers.
st_one() {
	local w="$1" dev bytes to url_d url_u bd bu dl ul srv
	st_config
	ST_DOWN_STATUS=not_run; ST_UP_STATUS=not_run
	dev=$(wan_dev "$w")
	[ -n "$dev" ] || { st_report "$w" 0 0 nodev; return 0; }
	bytes=${ST_BYTES:-$(g st_bytes 25000000)}
	to=$(g st_timeout 25)
	local streams dbytes
	streams=$(g st_streams 4)
	[ "$streams" -ge 1 ] 2>/dev/null || streams=4
	[ "$streams" -le 8 ] 2>/dev/null || streams=8
	[ "$to" -ge 1 ] 2>/dev/null && [ "$to" -le 120 ] 2>/dev/null || to=25
	# Active server profile (config server '<id>') wins; otherwise the inline
	# custom URLs. Either way a profile's blank field falls back to the inline
	# one, so you can define a download-only server.
	url_d="$ST_URL_DOWN"; url_u="$ST_URL_UP"
	# "{bytes}" is substituted; a URL ending in "=" gets the size appended
	# (old config format); anything else is fetched as-is (fixed-size file).
	# Divide the size across streams so total download ~= the configured size
	# (each parallel stream fetches a fraction). Fixed-file servers ignore this.
	dbytes=$((bytes / streams))
	[ "$dbytes" -ge 1000000 ] || dbytes="$bytes"
	case "$url_d" in
		*"{bytes}"*) url_d=$(echo "$url_d" | sed "s/{bytes}/$dbytes/g") ;;
		*=)          url_d="${url_d}${dbytes}" ;;
	esac

	# Parallel connections. A single TCP stream can't fill a fast link over any
	# real latency (bandwidth-delay product), so like every real speed test we
	# open several at once and sum their rates. -L follows redirects (Ookla
	# servers 307 http->their canonical https host, else they measure 0).
	local tmpd i ub per
	tmpd="/tmp/mkst.$w.$$"
	rm -rf "$tmpd"; mkdir -p "$tmpd"

	# Each direction gets one retry after a short pause: a stalled stream or a
	# server hiccup (curl exit 28 on an otherwise fine link) must not turn
	# into a failed round. Both attempts are ordinary transfers; only the
	# last one's figures are reported.
	progress speed "$w" download
	st_download
	if [ "$ST_DOWN_STATUS" != ok ]; then
		log "speedtest: $w download $ST_DOWN_STATUS - retrying once"
		sleep 2; progress speed "$w" download-retry
		st_download
	fi
	progress speed "$w" upload
	st_upload
	if [ "$ST_UP_STATUS" != ok ]; then
		log "speedtest: $w upload $ST_UP_STATUS - retrying once"
		sleep 2; progress speed "$w" upload-retry
		st_upload
	fi
	rm -rf "$tmpd"

	dl=$(awk -v b="$bd" 'BEGIN{ printf "%.2f", (b*8)/1000000 }')
	ul=$(awk -v b="$bu" 'BEGIN{ printf "%.2f", (b*8)/1000000 }')
	# A download of 0 means the server was unreachable/blocked: flag it so the
	# UI shows "failed" instead of a misleading "0 Mbps ok".
	local stt=ok
	[ "$ST_DOWN_STATUS" = ok ] && [ "$ST_UP_STATUS" = ok ] || stt=fail
	st_report "$w" "$dl" "$ul" "$stt"
}

# One download attempt for st_one: every stream in parallel, then the sum.
# Uses st_one's locals (dev, url_d, bytes, streams, to, tmpd) and leaves
# bd, ST_DOWN_STATUS and ST_HOST_DOWN set. Stale per-stream files from a
# previous attempt are cleared first so a shrunken asset list cannot leak.
st_download() {
	local i
	rm -f "$tmpd"/d* "$tmpd"/de* "$tmpd"/p* "$tmpd"/a* "$tmpd"/assets "$tmpd"/page.html
	if [ "$ST_DOWN_KIND" = page ]; then
		st_page_download "$dev" "$ST_URL_DOWN" "$bytes" "$streams" "$to" "$tmpd"
	else
		i=1
		while [ "$i" -le "$streams" ]; do
			(curl -sL --max-redirs 5 --proto '=http,https' --proto-redir '=http,https' \
				-o /dev/null --interface "$dev" --max-time "$to" \
				-w '%{speed_download} %{http_code} %{size_download} %{time_total} %{url_effective}\n' \
				"$url_d" > "$tmpd/d$i" 2>/dev/null; echo "$?" > "$tmpd/de$i") &
			i=$((i + 1))
		done
		wait
	fi
	bd=$(st_validate "$tmpd" d "$streams")
	# st_validate runs in a subshell: read its explicit status output.
	ST_DOWN_STATUS=$(cat "$tmpd/dstatus")
	ST_HOST_DOWN=$(cat "$tmpd/dhosts")
	[ -n "$bd" ] || bd=0
}

# One upload attempt for st_one: generated data (/dev/zero), one stream per
# connection. Total buffered across streams is capped so a big test size
# cannot OOM the router (curl buffers --data-binary); 50 MB is ample.
st_upload() {
	local i ub per
	rm -f "$tmpd"/u* "$tmpd"/ue*
	ub="$bytes"
	[ "$ub" -gt 52428800 ] 2>/dev/null && ub=52428800
	per=$((ub / streams))
	[ "$per" -ge 65536 ] || per=65536
	i=1
	while [ "$i" -le "$streams" ]; do
		(dd if=/dev/zero bs=65536 count=$((per / 65536)) 2>/dev/null | \
			curl -sL --max-redirs 5 --proto '=http,https' --proto-redir '=http,https' \
			-o /dev/null --interface "$dev" --max-time "$to" \
			-H 'Content-Type: application/octet-stream' \
			-w '%{speed_upload} %{http_code} %{size_upload} %{time_total} %{url_effective}\n' \
			--data-binary @- "$url_u" > "$tmpd/u$i" 2>/dev/null; echo "$?" > "$tmpd/ue$i") &
		i=$((i + 1))
	done
	wait
	bu=$(st_validate "$tmpd" u "$streams")
	ST_UP_STATUS=$(cat "$tmpd/ustatus")
	ST_HOST_UP=$(cat "$tmpd/uhosts")
	[ -n "$bu" ] || bu=0
}

# Reject HTTP error bodies, transport failures and incomplete directions.
# Record actual redirect destinations; never store effective URL secrets.
st_validate() {
	local dir="$1" direction="$2" streams="$3" i=1 code line rate http bytes elapsed url host sum=0 status=ok hosts=''
	while [ "$i" -le "$streams" ]; do
		code=$(cat "$dir/${direction}e$i" 2>/dev/null)
		read -r rate http bytes elapsed url < "$dir/$direction$i"
		host=$(st_host "$url")
		case ";$hosts;" in *";$host;"*) ;; *) hosts="${hosts:+$hosts;}$host" ;; esac
		if [ "$code" = 0 ] && awk -v h="$http" -v b="$bytes" -v t="$elapsed" -v r="$rate" \
			'BEGIN{exit !(h>=200 && h<300 && b>0 && t>0 && r>0)}'; then
			sum=$(awk -v a="$sum" -v b="$rate" 'BEGIN{printf "%.0f",a+b}')
		else
			status="http_${http:-000}_exit_${code:-unknown}"
		fi
		i=$((i+1))
	done
	printf '%s\n' "$status" > "$dir/${direction}status"
	printf '%s\n' "$hosts" > "$dir/${direction}hosts"
	[ "$status" = ok ] || sum=0
	echo "$sum"
}

# Current in-use throughput on a WAN's device (rx+tx), sampled over ~1s.
wan_busy_mbps() {
	local dev="$1" r1 t1 r2 t2
	r1=$(cat /sys/class/net/"$dev"/statistics/rx_bytes 2>/dev/null)
	t1=$(cat /sys/class/net/"$dev"/statistics/tx_bytes 2>/dev/null)
	sleep 1
	r2=$(cat /sys/class/net/"$dev"/statistics/rx_bytes 2>/dev/null)
	t2=$(cat /sys/class/net/"$dev"/statistics/tx_bytes 2>/dev/null)
	awk -v a="${r1:-0}" -v b="${r2:-0}" -v c="${t1:-0}" -v d="${t2:-0}" \
		'BEGIN{ v=((b-a)+(d-c))*8/1000000; if (v<0) v=0; printf "%.1f", v }'
}

cmd_speedtest() (
	flock -n 7 || { echo 'speed test already running' >&2; return 1; }
	local SPEED_FRESH_FILE="/tmp/multikmwan-fresh.$$" ST_META_FILE="/tmp/multikmwan-source.$$"
	: > "$SPEED_FRESH_FILE"; : > "$ST_META_FILE"
	trap 'rm -f "$SPEED_FRESH_FILE" "$ST_META_FILE" "$PROGRESS_FILE"' EXIT
	trap 'exit 1' INT TERM
	_cmd_speedtest "$@"
) 7>/var/lock/multikmwan-speed.lock

# Links a scheduled run will actually test: not disabled, not metered.
run_targets() {
	local w out=''
	for w in $1; do
		wan_disabled "$w" && continue
		wan_metered "$w" && continue
		out="$out $w"
	done
	echo $out
}

_cmd_speedtest() {
	local targets="$*" w line explicit=1 guard thr dev busy prior
	collect_wans
	[ -n "$targets" ] || { targets="$WANS"; explicit=0; }
	guard=$(g busy_skip 1)
	thr=$(g busy_mbps 20)
	local tmp="$SPEED_FILE.$$"
	PROG_I=0; PROG_N=$(run_targets "$targets" | wc -w)
	echo "# wan down_mbps up_mbps status epoch" > "$tmp"
	for w in $targets; do
		[ "$explicit" = 1 ] || ! wan_disabled "$w" || continue
		# A metered link is skipped unless named on the command line.
		if [ "$explicit" = 0 ] && wan_metered "$w"; then
			echo "$w 0 0 metered $(date +%s)" >> "$tmp"
			log "speedtest: $w is metered - skipped"
			continue
		fi
		# Don't test a link that's already busy (scheduled runs only): the test
		# would only see spare capacity (under-reporting) and would fight real
		# traffic. Carry the last good result forward instead. A manual run
		# (a named target) always tests.
		if [ "$explicit" = 0 ] && [ "$guard" = "1" ]; then
			dev=$(wan_dev "$w")
			busy=$(wan_busy_mbps "$dev")
			if awk -v x="$busy" -v t="$thr" 'BEGIN{ exit !(x+0 > t+0) }'; then
				prior=$(grep "^$w " "$SPEED_FILE" 2>/dev/null | grep -v busy | head -1)
				if [ -n "$prior" ]; then
					echo "$prior" >> "$tmp"       # keep last good line verbatim
				else
					echo "$w 0 0 busy $(date +%s)" >> "$tmp"
				fi
				log "speedtest: $w busy (${busy} Mbps in use > ${thr}) - skipped"
				continue
			fi
		fi
		log "speedtest: $w ..."
		PROG_I=$((PROG_I + 1)); progress speed "$w" start
		local ST_TEST_EPOCH
		ST_TEST_EPOCH=$(date +%s)
		line=$(st_one "$w")
		case "$line" in
			*" ok") echo "$line $ST_TEST_EPOCH" >> "$tmp" ;;
			*)
				# Still failed after the retry. Keep a recent good result (up to
				# 6 h old) rather than dropping the link from the ranking: one bad
				# transfer must not hand primary to a rival. The failed attempt
				# stays in the test log, and the card says which it is showing.
				prior=$(awk -v w="$w" -v min="$((ST_TEST_EPOCH - 21600))" \
					'$1==w && $4=="ok" && $5>=min' "$SPEED_FILE" 2>/dev/null | head -1)
				if [ -n "$prior" ]; then
					echo "$prior" >> "$tmp"
					log "speedtest: $w failed - keeping the result from $(( (ST_TEST_EPOCH - ${prior##* }) / 60 )) min ago"
				else
					echo "$line $ST_TEST_EPOCH" >> "$tmp"
				fi ;;
		esac
		echo "$line $ST_TEST_EPOCH" >> "$SPEED_FRESH_FILE"
		log "speedtest: $line"
	done
	rm -f "$PROGRESS_FILE"
	mv "$tmp" "$SPEED_FILE"
	hist_record_speed
	hist_rollup speed
	cat "$SPEED_FILE"
}

# Ring of the last N speed runs, for the status-page graph. Each line:
#   epoch wan:down:up wan2:down:up ...   (only 'ok' results)
HIST_KEEP=10
hist_record_speed() {
	local now toks w d u st e
	now=$(date +%s)
	toks=""
	while read -r w d u st e; do
		[ -n "$w" ] || continue
		[ "${w#\#}" = "$w" ] || continue
		[ "$st" = "ok" ] || continue
		toks="$toks $w:$d:$u:$e"
	done < "${SPEED_FRESH_FILE:-$SPEED_FILE}"
	[ -n "$toks" ] || return 0
	echo "$now$toks" >> "$SPEEDHIST_FILE"
	# keep the last HIST_KEEP lines
	tail -n "$HIST_KEEP" "$SPEEDHIST_FILE" > "$SPEEDHIST_FILE.$$" 2>/dev/null \
		&& mv "$SPEEDHIST_FILE.$$" "$SPEEDHIST_FILE"
}

# ------------------------------------------------------------ website test
# Bulk throughput alone does not decide which link feels fastest: a slow
# resolver or a long round trip to the big CDNs hurts every page more than a
# few Mbps do. So each WAN is also measured on real sites - one DNS lookup and
# one HTTPS fetch per configured page, bound to that WAN's device - and the
# "Fastest" ranking blends throughput, page response and DNS (see cmd_score).
#
# DNS is measured over DNS-over-HTTPS. A plain UDP lookup goes through
# dnsmasq and leaves on whichever WAN the main routing table prefers, so it
# cannot be attributed to one link; a DoH request bound to the device can.
# Only the request/response leg counts (TCP and TLS setup are subtracted),
# which is what a UDP query would cost - so the resolver's own hostname,
# looked up once through dnsmasq and then cached, never enters the figure.
# The default is a hostname rather than 1.1.1.1 because curl builds on
# mbedTLS cannot verify IP-address certificates. The answer is then pinned
# for the page fetch (curl --resolve) so the fetch is that WAN's own path
# and not dnsmasq's cache.
# Fetches go out as plain curl. A browser User-Agent without the rest of a
# browser's request makes Facebook answer 400; with curl's own identity all
# four default sites answer 2xx/3xx (verified on a GL-AX1800, Sep 2026).
WEB_DEFAULT_SITES='https://www.facebook.com/ https://www.youtube.com/ https://drive.google.com/ https://www.reddit.com/'
WEB_DEFAULT_DNS='https://cloudflare-dns.com/dns-query?name={name}&type=A'

web_sites() {
	local s
	s=$(g web_sites '')
	echo "${s:-$WEB_DEFAULT_SITES}"
}

web_timeout() {
	local to
	to=$(g web_timeout 10)
	case "$to" in ''|*[!0-9]*) to=10 ;; esac
	[ "$to" -ge 3 ] && [ "$to" -le 60 ] || to=10
	echo "$to"
}

# One lookup out of one WAN. Prints "<ms> <ipv4>", or "fail -".
web_dns() {
	local dev="$1" name="$2" to="$3" tmpj="$4" url line rc conn app start http st ip
	url="${DNS_URL:-$WEB_DEFAULT_DNS}"
	case "$url" in
		*"{name}"*) url=$(printf '%s' "$url" | sed "s/{name}/$name/g") ;;
		*) url="${url}${name}" ;;
	esac
	rm -f "$tmpj"
	line=$(curl -s -4 --interface "$dev" --max-time "$to" -H 'accept: application/dns-json' \
		-o "$tmpj" -w '%{time_connect} %{time_appconnect} %{time_starttransfer} %{http_code}' \
		"$url" 2>/dev/null); rc=$?
	set -- $line
	conn="${1:-0}"; app="${2:-0}"; start="${3:-0}"; http="${4:-000}"
	st=$(jsonfilter -q -i "$tmpj" -e '@.Status' 2>/dev/null)
	# A CNAME chain lists several records; the first A record is the one.
	ip=$(jsonfilter -q -i "$tmpj" -e '@.Answer[*].data' 2>/dev/null |
		grep -E '^[0-9]{1,3}(\.[0-9]{1,3}){3}$' | head -1)
	rm -f "$tmpj"
	if [ "$rc" = 0 ] && [ "$http" = 200 ] && [ "$st" = 0 ] && [ -n "$ip" ]; then
		awk -v c="$conn" -v a="$app" -v s="$start" -v ip="$ip" \
			'BEGIN{ b=(a>c?a:c); ms=(s-b)*1000; if (ms<0) ms=0; printf "%.0f %s\n", ms, ip }'
	else
		echo "fail -"
	fi
}

# One page out of one WAN. Prints "<first_byte_ms> <page_ms> <http> <status>";
# times exclude the name lookup. A redirect counts: the site's front door
# answered, which is the part the link is responsible for.
web_fetch() {
	local dev="$1" url="$2" to="$3" name="$4" port="$5" ip="$6" line rc
	if [ -n "$ip" ] && [ -n "$name" ]; then set -- --resolve "$name:$port:$ip"; else set --; fi
	line=$(curl -s -4 --interface "$dev" --max-time "$to" -o /dev/null \
		--proto '=http,https' "$@" \
		-w '%{time_namelookup} %{time_starttransfer} %{time_total} %{http_code}' "$url" 2>/dev/null); rc=$?
	awk -v rc="$rc" -v l="$line" 'BEGIN{
		split(l, f, " "); nl=f[1]+0; st=f[2]+0; tt=f[3]+0; http=f[4]+0
		ok=(rc==0 && http>=200 && http<400 && st>0)
		# A failed fetch has no meaningful timings; never print a negative one.
		fb=(st-nl)*1000; pg=(tt-nl)*1000; if (!ok || fb<0) fb=0; if (!ok || pg<0) pg=0
		printf "%.0f %.0f %03d %s\n", fb, pg, http, (ok ? "ok" : sprintf("http_%03d_exit_%s", http, rc)) }'
}

# Every configured site out of one WAN. Appends one row per site to $out
# (wan host dns_ms first_byte_ms page_ms http status epoch) and prints the
# WAN's summary row: wan dns_ms first_byte_ms page_ms ok total status epoch.
# DNS is the median lookup; the page figures are means over loaded sites.
web_wan() {
	local w="$1" dev="$2" to="$3" sites="$4" out="$5"
	local site host name port ip res dnsms n=0 ok=0 dlist='' tlist='' llist='' now tmpj
	tmpj="/tmp/mkweb.$w.$$"
	for site in $sites; do
		case "$site" in http://*|https://*) ;; *) continue ;; esac
		host=$(st_host "$site")
		[ -n "$host" ] || continue
		name="$host"; port=443
		case "$site" in http://*) port=80 ;; esac
		# A literal IPv6 host or an explicit port is fetched as-is, unpinned.
		case "$host" in
			\[*) name='' ;;
			*:*) name=${host%%:*}; port=${host##*:} ;;
		esac
		n=$((n + 1))
		now=$(date +%s)
		ip=''; dnsms='-'
		if [ -n "$name" ]; then
			res=$(web_dns "$dev" "$name" "$to" "$tmpj")
			dnsms=${res%% *}; ip=${res#* }
			[ "$dnsms" != fail ] || { dnsms='-'; ip=''; }
		fi
		res=$(web_fetch "$dev" "$site" "$to" "$name" "$port" "$ip")
		set -- $res
		if [ "$4" = ok ]; then
			ok=$((ok + 1)); tlist="$tlist $1"; llist="$llist $2"
			[ "$dnsms" = '-' ] || dlist="$dlist $dnsms"
		fi
		echo "$w $host $dnsms $1 $2 $3 $4 $now" >> "$out"
	done
	awk -v w="$w" -v d="$dlist" -v t="$tlist" -v l="$llist" -v ok="$ok" -v n="$n" -v now="$(date +%s)" 'BEGIN{
		nd=split(d, dv, " "); nt=split(t, tv, " "); nl=split(l, lv, " ")
		for (i=1; i<=nt; i++) ts+=tv[i]
		for (i=1; i<=nl; i++) ls+=lv[i]
		for (i=2; i<=nd; i++) { x=dv[i]; j=i-1; while (j>0 && dv[j]>x) { dv[j+1]=dv[j]; j-- } dv[j+1]=x }
		dm=(nd%2 ? dv[(nd+1)/2] : (dv[nd/2]+dv[nd/2+1])/2)
		printf "%s %s %s %s %d %d %s %d\n", w, (nd ? sprintf("%.0f", dm) : "-"),
			(nt ? sprintf("%.0f", ts/nt) : "-"), (nl ? sprintf("%.0f", ls/nl) : "-"), ok, n, (ok ? "ok" : "fail"), now }'
}

cmd_webtest() (
	# Shares the speed-test lock: two measurements on one link at the same
	# time would each distort the other.
	flock -n 7 || { echo 'a speed or website test is already running' >&2; return 1; }
	trap 'rm -f "$PROGRESS_FILE"' EXIT
	trap 'exit 1' INT TERM
	_cmd_webtest "$@"
) 7>/var/lock/multikmwan-speed.lock

_cmd_webtest() {
	local targets="$*" w explicit=1 guard thr dev busy to sites line now
	local tmpw="$WEB_FILE.$$" tmps="$WEBSITES_FILE.$$" tmpc="$CONTENT_FILE.$$"
	collect_wans
	[ -n "$targets" ] || { targets="$WANS"; explicit=0; }
	guard=$(g busy_skip 1); thr=$(g busy_mbps 20)
	to=$(web_timeout); sites=$(web_sites)
	DNS_URL=$(g dns_url "$WEB_DEFAULT_DNS")
	echo "# wan dns_ms first_byte_ms page_ms ok total status epoch" > "$tmpw"
	echo "# wan host dns_ms first_byte_ms page_ms http status epoch" > "$tmps"
	echo "# wan profile down_mbps status host epoch" > "$tmpc"
	PROG_I=0; PROG_N=$(run_targets "$targets" | wc -w)
	for w in $targets; do
		now=$(date +%s)
		[ "$explicit" = 1 ] || ! wan_disabled "$w" || continue
		if [ "$explicit" = 0 ] && wan_metered "$w"; then
			echo "$w - - - 0 0 metered $now" >> "$tmpw"
			log "webtest: $w is metered - skipped"
			continue
		fi
		dev=$(wan_dev "$w")
		[ -n "$dev" ] || { echo "$w - - - 0 0 nodev $now" >> "$tmpw"; continue; }
		if [ "$explicit" = 0 ] && [ "$guard" = "1" ]; then
			busy=$(wan_busy_mbps "$dev")
			if awk -v x="$busy" -v t="$thr" 'BEGIN{ exit !(x+0 > t+0) }'; then
				# Response times on a loaded link describe the load, not the
				# link. Carry the last result forward, as the speed test does.
				web_keep "$w" "$tmpw" "$tmps" "$tmpc" "$w - - - 0 0 busy $now"
				log "webtest: $w busy (${busy} Mbps in use > ${thr}) - skipped"
				continue
			fi
		fi
		log "webtest: $w ..."
		PROG_I=$((PROG_I + 1)); progress web "$w" sites
		line=$(web_wan "$w" "$dev" "$to" "$sites" "$tmps")
		echo "$line" >> "$tmpw"
		log "webtest: $line"
		web_content "$w" "$dev" "$tmpc"
	done
	rm -f "$PROGRESS_FILE"
	# A run naming specific WANs must not erase the others' results.
	if [ "$explicit" = 1 ]; then
		for w in $WANS; do
			case " $targets " in *" $w "*) continue ;; esac
			web_keep "$w" "$tmpw" "$tmps" "$tmpc" ''
		done
	fi
	mv "$tmpw" "$WEB_FILE"
	mv "$tmps" "$WEBSITES_FILE"
	mv "$tmpc" "$CONTENT_FILE"
	cat "$WEB_FILE"
}

# Copy a WAN's previous summary, site and content rows into the files being
# built; $5 is written instead when there is no previous summary (may be empty).
web_keep() {
	local w="$1" tmpw="$2" tmps="$3" tmpc="$4" fallback="$5" prior
	prior=$(grep "^$w " "$WEB_FILE" 2>/dev/null | head -1)
	if [ -n "$prior" ]; then echo "$prior" >> "$tmpw"
	elif [ -n "$fallback" ]; then echo "$fallback" >> "$tmpw"; fi
	grep "^$w " "$WEBSITES_FILE" 2>/dev/null >> "$tmps"
	grep "^$w " "$CONTENT_FILE" 2>/dev/null >> "$tmpc"
}

# Server profiles of kind "page" (Facebook by default): ids, one per line.
content_profiles() {
	uci show multikmwan 2>/dev/null | sed -n "s/^multikmwan\.\([A-Za-z0-9_]*\)\.kind='page'$/\1/p"
}

# Real-content throughput out of one WAN for every "page" profile, whether
# or not one of them is the active speed-test server: this is what answers
# "which line loads Facebook faster" on the Status page. Same machinery as
# the speed test (st_page_download + st_validate), same size and stream
# settings; ST_BYTES from auto-rank keeps scheduled runs small. Appends
# rows "wan profile down_mbps status host epoch" to $3.
web_content() {
	local w="$1" dev="$2" out="$3" p url bytes streams to tmpd bd dl st host now
	bytes=${ST_BYTES:-$(g st_bytes 25000000)}
	streams=$(g st_streams 4)
	[ "$streams" -ge 1 ] 2>/dev/null || streams=4
	[ "$streams" -le 8 ] 2>/dev/null || streams=8
	to=$(g st_timeout 25)
	[ "$to" -ge 1 ] 2>/dev/null && [ "$to" -le 120 ] 2>/dev/null || to=25
	for p in $(content_profiles); do
		url=$(uci -q get multikmwan."$p".down_url)
		case "$url" in http://*|https://*) ;; *) continue ;; esac
		tmpd="/tmp/mkct.$w.$$"
		rm -rf "$tmpd"; mkdir -p "$tmpd"
		now=$(date +%s)
		progress web "$w" "$p"
		st_page_download "$dev" "$url" "$bytes" "$streams" "$to" "$tmpd"
		bd=$(st_validate "$tmpd" d "$streams")
		st=$(cat "$tmpd/dstatus"); host=$(cat "$tmpd/dhosts")
		if [ "$st" != ok ]; then
			# One retry, as the speed test does: a stalled stream is not a verdict.
			log "webtest: $w $p $st - retrying once"
			sleep 2; progress web "$w" "$p-retry"
			rm -rf "$tmpd"; mkdir -p "$tmpd"
			st_page_download "$dev" "$url" "$bytes" "$streams" "$to" "$tmpd"
			bd=$(st_validate "$tmpd" d "$streams")
			st=$(cat "$tmpd/dstatus"); host=$(cat "$tmpd/dhosts")
		fi
		rm -rf "$tmpd"
		dl=$(awk -v b="${bd:-0}" 'BEGIN{ printf "%.2f", (b*8)/1000000 }')
		echo "$w $p $dl $st ${host:-$(st_host "$url")} $now" >> "$out"
		log "webtest: $w $p ${dl} Mbps ($st)"
	done
}

# Mean ping round trip per WAN over the last $1 seconds, from the monitor's
# samples (ts,wan,state,rtt,...). Prints "wan ms". Falls back to the latest
# health line when the monitor has not filled a window yet, e.g. just after
# boot. Only numeric RTTs count, so a link that was down contributes nothing.
score_latency() {
	local win="$1" now
	now=$(date +%s)
	case "$win" in ''|*[!0-9]*) win=300 ;; esac
	{ [ -f "$QUALITY_DIR/samples" ] && tail -n 2000 "$QUALITY_DIR/samples"; } |
		awk -F, -v now="$now" -v win="$win" \
			'$1 >= now - win && $4 ~ /^[0-9]+([.][0-9]+)?$/ { s[$2] += $4; n[$2]++ }
			 END { for (w in n) printf "%s %.1f\n", w, s[w] / n[w] }'
}

# Composite "fastest" score, best first, from the last speed test, the last
# website test and recent ping latency (score.awk has the formula). Columns:
#   composite wan speed_pts dns_pts web_pts speed_mbps dns_ms first_byte_ms down up sites lat_pts lat_ms
cmd_score() {
	local by="${1:-$(g rank_by sum)}" ws wd ww wl sf lf
	case "$by" in down|up|sum) ;; *) by=sum ;; esac
	ws=$(g score_w_speed 40); ww=$(g score_w_web 25); wl=$(g score_w_latency 20); wd=$(g score_w_dns 15)
	[ -f "$SPEED_FILE" ] || return 1
	sf="$WEBSITES_FILE"; [ -f "$sf" ] || sf=/dev/null
	lf="/tmp/multikmwan.latency.$$"
	score_latency "$(g score_rtt_window 300)" > "$lf"
	[ -s "$lf" ] || awk '$2 ~ /^[0-9]+([.][0-9]+)?$/ { print $1, $2 }' "$HEALTH_FILE" 2>/dev/null > "$lf"
	awk -v by="$by" -v ws="$ws" -v wd="$wd" -v ww="$ww" -v wl="$wl" \
		-v speed="$SPEED_FILE" -v sites="$sf" -v latency="$lf" \
		-f "$QUALITY_LIB/score.awk" "$SPEED_FILE" "$sf" "$lf" | sort -rn
	rm -f "$lf"
}

# --------------------------------------------------------------- ranking
# Applies the last speed-test result to kmwan: metrics for failover order,
# weights for the load-balance ratio.

# Prints "score wan down up", fastest first. With rank_mode=score (the
# default) the score is the composite of throughput, page response and DNS;
# otherwise it is the throughput figure named by $1 (sum|down|up).
rank_sorted() {
	local by="$1" w d u st e score
	[ -f "$SPEED_FILE" ] || return 1
	if [ "$(g rank_mode score)" = "score" ]; then
		cmd_score "$by" | awk '{print $1, $2, $9, $10}'
		return 0
	fi
	while read -r w d u st e; do
		[ -n "$w" ] || continue
		[ "${w#\#}" = "$w" ] || continue
		[ "$st" = "ok" ] || continue
		if [ "$by" = "down" ]; then
			score="$d"
		elif [ "$by" = "up" ]; then
			score="$u"
		else
			score=$(awk -v a="$d" -v b="$u" 'BEGIN{printf "%.2f", a+b}')
		fi
		echo "$score $w $d $u"
	done < "$SPEED_FILE" | sort -rn
}

# Non-metered WANs in kmwan's current failover order (fastest-first as it stands).
current_order() {
	local w
	collect_wans
	for w in $WANS; do
		wan_metered "$w" && continue
		echo "$(uci -q get kmwan.$w.metric) $w"
	done | sort -n | awk '{printf "%s ", $2}'
}

# stdin: rank_sorted output.  $1: metric|weight|both.  Applies + restarts kmwan.
rank_apply() {
	local what="${1:-both}" sorted score w d u max m=1 wt
	sorted=$(cat)
	[ -n "$sorted" ] || { echo "no usable results" >&2; return 1; }
	max=$(echo "$sorted" | head -1 | awk '{print $1}')

	echo "$sorted" | while read -r score w d u; do
		if [ "$what" = "metric" ] || [ "$what" = "both" ]; then
			uci set kmwan."$w".metric="$m"
		fi
		if [ "$what" = "weight" ] || [ "$what" = "both" ]; then
			wt=$(awk -v s="$score" -v mx="$max" 'BEGIN{
				if (mx <= 0) { print 1; exit }
				v = int((s/mx)*10 + 0.5); if (v < 1) v = 1; if (v > 10) v = 10; print v }')
			uci set kmwan."$w".weight="$wt"
			echo "$w: metric=$m weight=$wt (score $score, ${d}down/${u}up)"
		else
			echo "$w: metric=$m (score $score)"
		fi
		m=$((m + 1))
	done

	# Metered / backup-only links: after everything measured, ranked last, ratio 0.
	m=$(( $(echo "$sorted" | wc -l) + 1 ))
	collect_wans
	for w in $WANS; do
		wan_metered "$w" || continue
		if [ "$what" = "metric" ] || [ "$what" = "both" ]; then
			uci set kmwan."$w".metric="$m"
		fi
		if [ "$what" = "weight" ] || [ "$what" = "both" ]; then
			uci set kmwan."$w".weight="0"
		fi
		echo "$w: metric=$m weight=0 (metered - backup only)"
		m=$((m + 1))
	done

	uci commit kmwan
	/etc/init.d/kmwan restart >/dev/null 2>&1
}

cmd_rank() {
	local by="${1:-$(g rank_by sum)}" what="${2:-both}"
	[ -f "$SPEED_FILE" ] || { echo "no speed results; run: multikmwan speedtest" >&2; return 1; }
	rank_sorted "$by" | rank_apply "$what" || return 1
	log "ranked WANs by $by (applied to $what)"
}

# Scheduled re-rank. Re-tests with a smaller payload, then applies ONLY when
# the leader actually changes AND the new leader beats the current one by
# auto_margin percent -- every apply restarts kmwan (~7s re-probe + route
# reload), so two lines of similar speed must not flip-flop.
cmd_autorank() {
	local by what margin bytes sorted proposed current
	local new_lead new_score cur_lead cur_score now decision
	by=$(g rank_by sum); what=$(g auto_what both)
	margin=$(g auto_margin 15); bytes=$(g auto_bytes 10000000)
	now=$(date +%s)

	ST_BYTES="$bytes" ST_KIND=scheduled cmd_speedtest >/dev/null 2>&1 || return 1
	# The composite needs fresh page and DNS figures too. The speed test has
	# just released the shared lock, so this cannot collide with it.
	[ "$(g rank_mode score)" != "score" ] || ST_BYTES="$bytes" cmd_webtest >/dev/null 2>&1 || \
		log "autorank: website test did not run; using its previous result"
	sorted=$(rank_sorted "$by")
	if [ -z "$sorted" ]; then
		echo "$now no-results -" > "$AUTO_FILE"
		log "autorank: no usable speed results"
		return 1
	fi
	proposed=$(echo "$sorted" | awk '{printf "%s ", $2}')
	current=$(current_order)

	if [ "$proposed" = "$current" ]; then
		decision="unchanged"
	else
		new_lead=$(echo "$sorted" | head -1 | awk '{print $2}')
		new_score=$(echo "$sorted" | head -1 | awk '{print $1}')
		cur_lead=${current%% *}
		cur_score=$(echo "$sorted" | awk -v w="$cur_lead" '$2==w {print $1}')
		if [ "$new_lead" = "$cur_lead" ]; then
			decision="same-leader"
		elif [ -z "$cur_score" ]; then
			# The current leader has no score this round (its test failed and
			# nothing recent could stand in). Missing data must not demote it.
			decision="leader-unmeasured"
		elif awk -v n="$new_score" -v c="$cur_score" -v m="$margin" \
				'BEGIN{ exit !(n < c * (1 + m/100)) }'; then
			decision="within-margin"
		else
			echo "$sorted" | rank_apply "$what" >/dev/null 2>&1
			decision="applied"
		fi
	fi
	echo "$now $decision $proposed" > "$AUTO_FILE"
	log "autorank: $decision (measured: ${proposed}| current: ${current})"
	echo "$decision: $proposed"
}

# procd service loop. health + sync + geo every interval; the scheduled
# re-rank when auto_rank minutes have elapsed. Never on the first pass, so a
# reboot does not open with a speed test.
cmd_loop() {
	local interval ar now last flushed day today
	last=$(date +%s)
	flushed=$(date +%s)
	day=$(date +%Y-%m-%d)
	while :; do
		interval=$(g interval 20)
		cmd_sync >/dev/null 2>&1
		cmd_geo >/dev/null 2>&1
		ar=$(g auto_rank 0)
		now=$(date +%s)
		if [ "${ar:-0}" -gt 0 ] && [ $((now - last)) -ge $((ar * 60)) ]; then
			cmd_autorank >/dev/null 2>&1
			last=$(date +%s)
		fi
		# Persist to flash at most hourly, and immediately on a date change so
		# a day's totals are never split across a lost /tmp.
		today=$(date +%Y-%m-%d)
		if [ "$today" != "$day" ] || [ $((now - flushed)) -ge 3600 ]; then
			hist_flush >/dev/null 2>&1
			flushed=$(date +%s); day="$today"
		fi
		sleep "$interval"
	done
}

# Independent procd instance. Work duration is subtracted from the cadence;
# missed deadlines are visible as gaps instead of invented downtime.
cmd_monitor() {
	local interval started elapsed delay
	while :; do
		interval=$(health_interval)
		started=$(date +%s)
		cmd_health >/dev/null 2>&1
		elapsed=$(( $(date +%s) - started ))
		delay=$((interval - elapsed))
		[ "$delay" -ge 1 ] && [ "$delay" -le "$interval" ] || delay=1
		sleep "$delay"
	done
}

health_interval() {
	local interval
	interval=$(g interval 20)
	case "$interval" in ''|*[!0-9]*) interval=20 ;; esac
	[ "$interval" -ge 5 ] && [ "$interval" -le 3600 ] || interval=20
	echo "$interval"
}

# ------------------------------------------------------------------ health
# Latency and loss per WAN, pinging out of that WAN's own device so the
# answer is about that link rather than whichever one routing prefers.
wan_track_ip() {
	local t
	t=$(uci -q get kmwan."$1".tracks | awk '{print $1}')
	t="${t#ping,}"
	echo "${t:-1.1.1.1}"
}

health_one() {
	local w="$1" interval="$2" dev tgt result state reason
	dev=$(wan_dev "$w")
	tgt=$(wan_track_ip "$w")
	# Restrict stored tokens and prevent ping options from a malformed target.
	case "$tgt" in ''|[!A-Za-z0-9]*|*[!A-Za-z0-9.:-]*) tgt=1.1.1.1 ;; esac
	[ "${#tgt}" -le 253 ] || tgt=1.1.1.1
	if [ "$(uci -q get kmwan."$w".disabled)" = 1 ]; then
		result='- - - 0 0 disabled'; reason=not_tracked
	elif [ -z "$dev" ]; then
		result='- 100 - 0 0 down'; reason=no_device
	elif ! network_is_up "$w"; then
		result='- 100 - 0 0 down'; reason=link_down
	else
		result=$(LC_ALL=C ping -n -4 -I "$dev" -c 3 -W 1 -w 5 "$tgt" 2>/dev/null |
			awk -f "$QUALITY_LIB/ping.awk")
		state=${result##* }
		case "$state" in
			down) reason=probe_failed ;; degraded) reason=loss_or_latency ;;
			healthy) reason=probe_ok ;; *) reason=probe_error ;;
		esac
	fi
	set -- $result
	# Anything but the six probe fields (awk helper missing mid-upgrade, ping
	# killed) must not shift columns: readers would show the epoch as RTT.
	[ $# -eq 6 ] || { set -- - - - 0 0 unknown; reason=probe_error; }
	printf '%s %s %s %s %s %s %s %s %s %s %s\n' "$w" "$1" "$2" "$(date +%s)" \
		"$3" "$4" "$5" "$6" "$tgt" "$interval" "$reason"
}

cmd_health() (
	# Kernel locks release on crashes. Manual refreshes cannot overlap the
	# monitor or race an RPC reader. Slow speed work uses a different lock.
	flock -n 9 || return 0
	mkdir -p "$QUALITY_DIR" || return 1
	local w count=0 interval tmp work now
	interval=$(health_interval)
	work=$(mktemp -d "$QUALITY_DIR/probe.XXXXXX") || return 1
	tmp="$HEALTH_FILE.$$"
	trap 'rm -f "$tmp"; rm -rf "$work"' EXIT
	trap 'exit 1' INT TERM
	collect_wans
	for w in $WANS; do
		case "$w" in ''|*[!A-Za-z0-9_.-]*) continue ;; esac
		[ "${#w}" -le 64 ] || continue
		health_one "$w" "$interval" > "$work/$w" &
		count=$((count+1))
		# Bound process count even on configurations with many WANs.
		[ $((count % 4)) -eq 0 ] && wait
	done
	wait
	: > "$tmp"
	for w in "$work"/*; do [ -f "$w" ] && cat "$w" >> "$tmp"; done
	mv "$tmp" "$HEALTH_FILE" || return 1
	now=$(date +%s)
	exec 6>/var/lock/multikmwan-quality.lock
	flock_wait 6 2 || return 1
	touch "$QUALITY_DIR/state" "$QUALITY_DIR/samples" "$QUALITY_DIR/events"
	: > "$QUALITY_DIR/state.next"
	awk -v previous="$QUALITY_DIR/state" -v nextstate="$QUALITY_DIR/state.next" \
		-v samples="$QUALITY_DIR/samples" -v events="$QUALITY_DIR/events" \
		-f "$QUALITY_LIB/quality-update.awk" "$QUALITY_DIR/state" "$HEALTH_FILE" || return 1
	mv "$QUALITY_DIR/state.next" "$QUALITY_DIR/state"
	# Numeric/token-only records are at most 512 bytes. Caps bound RAM use
	# across any number of WANs; pruned periods appear as missing coverage.
	awk -F, -v now="$now" '$1>=now-86400 && $1<=now && length($0)<=512' \
		"$QUALITY_DIR/samples" | tail -n 16384 > "$QUALITY_DIR/samples.next"
	mv "$QUALITY_DIR/samples.next" "$QUALITY_DIR/samples"
	awk -F, -v now="$now" '$1>=now-86400 && $1<=now' "$QUALITY_DIR/events" |
		tail -n 512 > "$QUALITY_DIR/events.next"
	mv "$QUALITY_DIR/events.next" "$QUALITY_DIR/events"
	flock -u 6
	hist_rollup health
	cat "$HEALTH_FILE"
) 9>/var/lock/multikmwan-health.lock

# --------------------------------------------------------------------- geo
# Public IP, ISP and rough location per WAN. Cached for 6h: the lookup is
# rate-limited and only changes when the ISP re-addresses you.
GEO_MAX_AGE=21600

geo_one() {
	local w="$1" dev j ip isp city region country
	dev=$(wan_dev "$w")
	[ -n "$dev" ] || return 1
	j=$(curl -s --interface "$dev" --max-time 8 \
		'http://ip-api.com/json/?fields=status,query,isp,org,city,regionName,countryCode' 2>/dev/null)
	if [ "$(echo "$j" | jsonfilter -q -e '@.status')" = "success" ]; then
		ip=$(echo "$j" | jsonfilter -q -e '@.query')
		isp=$(echo "$j" | jsonfilter -q -e '@.isp')
		[ -n "$isp" ] || isp=$(echo "$j" | jsonfilter -q -e '@.org')
		city=$(echo "$j" | jsonfilter -q -e '@.city')
		region=$(echo "$j" | jsonfilter -q -e '@.regionName')
		country=$(echo "$j" | jsonfilter -q -e '@.countryCode')
	else
		j=$(curl -s --interface "$dev" --max-time 8 https://ipinfo.io/json 2>/dev/null)
		ip=$(echo "$j" | jsonfilter -q -e '@.ip')
		[ -n "$ip" ] || return 1
		isp=$(echo "$j" | jsonfilter -q -e '@.org' | sed 's/^AS[0-9]* //')
		city=$(echo "$j" | jsonfilter -q -e '@.city')
		region=$(echo "$j" | jsonfilter -q -e '@.region')
		country=$(echo "$j" | jsonfilter -q -e '@.country')
	fi
	printf '%s|%s|%s|%s|%s|%s|%s\n' "$w" "$ip" "$isp" "$city" "$region" "$country" "$(date +%s)"
}

cmd_geo() {
	local force="$1" w line age now last
	now=$(date +%s)
	if [ "$force" != "force" ] && [ -s "$GEO_FILE" ]; then
		last=$(awk -F'|' 'NR==1{print $7}' "$GEO_FILE")
		age=$((now - ${last:-0}))
		[ "$age" -lt "$GEO_MAX_AGE" ] && return 0
	fi
	collect_wans
	local tmp="$GEO_FILE.$$"
	: > "$tmp"
	for w in $WANS; do
		line=$(geo_one "$w") && echo "$line" >> "$tmp"
	done
	mv "$tmp" "$GEO_FILE"
	cat "$GEO_FILE"
}

# ---------------------------------------------------------------- history
# Small but useful over 90 days. We do NOT log every sample. A per-day
# accumulator (ACC_FILE, in RAM) is updated each cycle in ONE awk pass;
# hist_flush folds it into flash as one row per WAN per day and prunes to
# HIST_DAYS. Result: a few hundred rows, a couple of KB, ~24 flash writes/day.
#
# Row schema (ACC_FILE and HIST_FILE), CSV:
#   date,wan,up,down,rtt_sum,rtt_n,loss_sum,loss_n,outages,dl_sum,dl_n,dl_max,ul_sum,ul_n,ul_max
# up/down = count of health samples seen online/offline (=> uptime %).

# Fold the latest health OR speed results into today's accumulator rows.
# One awk invocation; state/outage edges tracked via STATE_FILE.
hist_rollup() (
	flock_wait 8 5 || return 1
	_hist_rollup "$@"
) 8>/var/lock/multikmwan-history.lock

_hist_rollup() {
	local kind="$1" today
	today=$(date +%Y-%m-%d)
	[ -f "$ACC_FILE" ]   || : > "$ACC_FILE"
	[ -f "$STATE_FILE" ] || : > "$STATE_FILE"

	if [ "$kind" = "health" ] && [ -f "$HEALTH_FILE" ]; then
		awk -F' ' -v d="$today" '
			# 1) previous per-wan state
			FILENAME==SF { st[$1]=$2; next }
			# 2) todays accumulator rows (CSV)
			FILENAME==AF {
				split($0,c,","); if (c[1]==d) { for(i=3;i<=15;i++) A[c[2]","i]=c[i]; have[c[2]]=1 }
				else keep[NR]=$0
				next
			}
			# 3) health lines: wan rtt loss epoch
			{
				w=$1; rtt=$2; loss=$3; if(w=="" || $8=="disabled" || $8=="unknown")next
				have[w]=1
				if (loss=="100" || rtt=="-") {
					A[w",4"]++                              # down
					if (st[w]!="down") A[w",9"]++          # outage edge
					st[w]="down"
				} else {
					A[w",3"]++                              # up
					if (rtt!="-") { A[w",5"]+=rtt; A[w",6"]++ }
					A[w",7"]+=loss+0; A[w",8"]++
					st[w]="up"
				}
			}
			END {
				for (n in keep) print keep[n] > AO
				for (w in have) {
					line=d","w
					for(i=3;i<=15;i++) line=line","(A[w","i]+0)
					print line > AO
				}
				for (w in st) print w" "st[w] > SO
			}
		' SF="$STATE_FILE" AF="$ACC_FILE" AO="$ACC_FILE.$$" SO="$STATE_FILE.$$" \
			"$STATE_FILE" "$ACC_FILE" "$HEALTH_FILE" >/dev/null 2>&1
		[ -f "$ACC_FILE.$$" ] && mv "$ACC_FILE.$$" "$ACC_FILE"
		[ -f "$STATE_FILE.$$" ] && mv "$STATE_FILE.$$" "$STATE_FILE"
	fi

	if [ "$kind" = "speed" ] && [ -f "$SPEED_FILE" ]; then
		awk -F' ' -v d="$today" '
			FILENAME==AF {
				split($0,c,","); if (c[1]==d) { for(i=3;i<=15;i++) A[c[2]","i]=c[i]; have[c[2]]=1 }
				else keep[NR]=$0
				next
			}
			{
				w=$1; dl=$2; ul=$3; stt=$4
				if (w=="" || w ~ /^#/ || stt!="ok") next
				# Sanity clamp: ignore implausible readings (>200 Gbps) so a
				# glitchy measurement can never poison the daily history.
				if (dl+0 < 0 || dl+0 > 200000) next
				if (ul+0 > 200000) ul=0
				have[w]=1
				A[w",10"]+=dl; A[w",11"]++; if (dl+0>A[w",12"]+0) A[w",12"]=dl
				A[w",13"]+=ul; A[w",14"]++; if (ul+0>A[w",15"]+0) A[w",15"]=ul
			}
			END {
				for (n in keep) print keep[n] > AO
				for (w in have) {
					line=d","w
					for(i=3;i<=15;i++) line=line","(A[w","i]+0)
					print line > AO
				}
			}
		' AF="$ACC_FILE" AO="$ACC_FILE.$$" "$ACC_FILE" "${SPEED_FRESH_FILE:-$SPEED_FILE}" >/dev/null 2>&1
		[ -f "$ACC_FILE.$$" ] && mv "$ACC_FILE.$$" "$ACC_FILE"
		if [ -s "$ST_META_FILE" ]; then
			[ -f /tmp/multikmwan-tests.csv ] || cp "$HIST_DIR/tests.csv" /tmp/multikmwan-tests.csv 2>/dev/null
			cat /tmp/multikmwan-tests.csv "$ST_META_FILE" 2>/dev/null | tail -n 256 > /tmp/multikmwan-tests.next
			mv /tmp/multikmwan-tests.next /tmp/multikmwan-tests.csv
		fi
	fi
}

# Merge the accumulator into flash, clear it, prune > HIST_DAYS. Called on a
# cadence and on date change, so flash sees ~hourly writes at most.
hist_flush() (
	flock_wait 8 5 || return 1
	_hist_flush
) 8>/var/lock/multikmwan-history.lock

_hist_flush() {
	local cutoff
	mkdir -p "$HIST_DIR"
	if [ -f /tmp/multikmwan-tests.csv ]; then
		cp /tmp/multikmwan-tests.csv "$HIST_DIR/tests.csv.next" && mv "$HIST_DIR/tests.csv.next" "$HIST_DIR/tests.csv"
	fi
	[ -s "$ACC_FILE" ] || return 0
	cutoff=$(date -d "-${HIST_DAYS} days" +%Y-%m-%d 2>/dev/null)
	[ -f "$HIST_FILE" ] || : > "$HIST_FILE"
	awk -F, '
		FNR==NR { k=$1","$2; for(i=3;i<=15;i++) A[k","i]=$i; acc[k]=1; next }
		{
			k=$1","$2
			if (k in acc) {
				for(i=3;i<=15;i++) if (i==12||i==15) { if (A[k","i]>$i) $i=A[k","i] } else $i=$i+A[k","i]
				done_[k]=1
			}
			print
		}
		END { for (k in acc) if (!(k in done_)) {
			split(k,p,","); line=p[1]","p[2]; for(i=3;i<=15;i++) line=line","(A[k","i]+0); print line } }
	' OFS=, "$ACC_FILE" "$HIST_FILE" | \
		awk -F, -v c="$cutoff" '(c=="" || $1>=c)' | sort -t, -k1,1 -k2,2 > "$HIST_FILE.$$" \
		&& mv "$HIST_FILE.$$" "$HIST_FILE" || return 1
	: > "$ACC_FILE"
}

cmd_history() { cat "$HIST_FILE" 2>/dev/null; }


# ----------------------------------------------------------------- checks
cmd_check() {
	local w dev gw ok=0 zone
	collect_wans
	echo "kmwan mode      : $(uci -q get kmwan.global.mode)"
	echo "multikmwan enabled : $(g enabled 0)"
	echo "table base      : $TABLE_BASE   rule base: $RULE_BASE"
	echo ""
	printf "%-8s %-7s %-16s %-7s %-7s %-8s %-9s %s\n" WAN DEV GATEWAY TABLE METRIC WEIGHT KMWAN METERED
	for w in $WANS; do
		dev=$(wan_dev "$w")
		gw=$(wan_gw "$dev" | head -1)
		printf "%-8s %-7s %-16s %-7s %-7s %-8s %-9s %s\n" \
			"$w" "$dev" "${gw:--}" "$(wan_table "$w")" \
			"$(uci -q get kmwan.$w.metric)" "$(uci -q get kmwan.$w.weight)" \
			"$([ "$(uci -q get kmwan.$w.disabled)" = "1" ] && echo DISABLED || echo enabled)" \
			"$(wan_metered "$w" && echo yes || echo no)"
	done
	echo ""
	echo "NAT check (a client routed out an un-masqueraded WAN is blackholed):"
	for w in $WANS; do
		zone=$(uci show firewall 2>/dev/null | grep "\.network=.*'$w'" | cut -d. -f2 | head -1)
		if [ -n "$zone" ]; then
			if [ "$(uci -q get firewall.$zone.masq)" = "1" ] || \
			   [ "$(uci -q get firewall.@zone[$(echo $zone | tr -dc 0-9)].masq)" = "1" ]; then
				echo "  $w: masqueraded (zone $zone)  OK"
			else
				echo "  $w: zone $zone has masq != 1  CHECK"
			fi
		else
			echo "  $w: no firewall zone found  CHECK"
		fi
		ok=$((ok + 1))
	done
	echo ""
	echo "Active multikmwan rules:"
	ip rule show | awk -F: -v lo="$RULE_BASE" -v hi="$RULE_MAX" '{pr=$1+0} pr>=lo && pr<=hi' || true
	ip rule show | awk -F: -v lo="$RULE_BASE" -v hi="$RULE_MAX" '{pr=$1+0} pr>=lo && pr<=hi' | \
		grep -q . || echo "  (none)"
}

cmd_status() {
	collect_wans
	echo "WANS: $WANS"
	echo "--- kmwan ---"
	cat /proc/gl-kmwan/status 2>/dev/null | head -40
	echo "--- rules ---"
	ip rule show
	echo "--- speed ---"
	cat "$SPEED_FILE" 2>/dev/null || echo "(no results)"
	echo "--- websites ---"
	cat "$WEB_FILE" 2>/dev/null || echo "(no results)"
	echo "--- score ---"
	cmd_score 2>/dev/null || echo "(no results)"
	echo "--- health ---"
	cat "$HEALTH_FILE" 2>/dev/null || echo "(no results)"
	echo "--- geo ---"
	cat "$GEO_FILE" 2>/dev/null || echo "(no results)"
}

case "$1" in
	sync)      cmd_sync ;;
	flush)     cmd_flush ;;
	mode)      shift; cmd_mode "$@" ;;
	speedtest) shift; cmd_speedtest "$@" ;;
	webtest)   shift; cmd_webtest "$@" ;;
	score)     shift; cmd_score "$@" ;;
	rank)      shift; cmd_rank "$@" ;;
	check)     cmd_check ;;
	health)    cmd_health ;;
	autorank)  cmd_autorank ;;
	history)   cmd_history ;;
	hist-flush) hist_flush ;;
	loop)      cmd_loop ;;
	monitor)   cmd_monitor ;;
	geo)       shift; cmd_geo "$@" ;;
	status)    cmd_status ;;
	test-source) st_config; printf '%s|%s|%s|%s\n' "$ST_LABEL" "$ST_PROFILE" "$ST_HOST_DOWN" "$ST_HOST_UP" ;;
	*)
		cat <<USAGE
multikmwan - per-client WAN preference + speed ranking for GL kmwan

  multikmwan check                    show WANs, tables, NAT sanity, active rules
  multikmwan sync                     apply client rules and per-WAN tables
  multikmwan flush                    remove everything multikmwan installed
  multikmwan mode [failover|balancing]  get/set kmwan mode
  multikmwan speedtest [wan ...]      measure down/up per WAN (binds to each dev)
  multikmwan webtest [wan ...]        DNS lookup + page response per WAN, on real sites
  multikmwan score [sum|down|up]      composite ranking: throughput + page response + DNS
  multikmwan rank [sum|down|up] [both|metric|weight]
                                   apply the ranking to kmwan
  multikmwan health                   ping latency/loss out of each WAN
  multikmwan autorank                 re-test speed + websites and re-rank if the leader changed
  multikmwan history                  print the 90-day daily history CSV
  multikmwan geo [force]              public IP / ISP / location per WAN
  multikmwan status                   kmwan status + rules + last speed results
USAGE
		;;
esac
