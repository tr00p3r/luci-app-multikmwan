#!/bin/sh /etc/rc.common
# kmwan changes routes without emitting an iface event, so poll as well as
# hooking hotplug.
START=95
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance worker
	procd_set_param command /usr/sbin/multikmwan loop
	procd_set_param respawn
	procd_close_instance
	# Slow speed/geo/routing work must never hold up health measurements.
	procd_open_instance monitor
	procd_set_param command /usr/sbin/multikmwan monitor
	procd_set_param respawn
	procd_close_instance
}

stop_service() {
	/usr/sbin/multikmwan hist-flush >/dev/null 2>&1
	/usr/sbin/multikmwan flush >/dev/null 2>&1
}

service_triggers() {
	procd_add_reload_trigger "multikmwan" "kmwan"
}
