#!/bin/sh
# Seed MultiKmwan defaults exactly once, WITHOUT ever clobbering existing
# settings. Shipped as a uci-defaults script (not a conffile) on purpose: a
# conffile is deleted by `opkg remove` and by `--force-reinstall`, which is how
# settings used to get wiped. This runs on install, is idempotent, and removes
# itself; on any later reinstall it sees the existing config and does nothing.
[ -f /etc/config/multikmwan ] || touch /etc/config/multikmwan

if [ -z "$(uci -q get multikmwan.global)" ]; then
	uci -q batch <<'EOF'
set multikmwan.global=global
set multikmwan.global.enabled=0
set multikmwan.global.table_base=200
set multikmwan.global.rule_base=2000
set multikmwan.global.interval=20
set multikmwan.global.st_bytes=25000000
set multikmwan.global.st_timeout=25
set multikmwan.global.st_down_url=https://speed.cloudflare.com/__down?bytes={bytes}
set multikmwan.global.st_up_url=https://speed.cloudflare.com/__up
set multikmwan.global.active_server=
set multikmwan.global.rank_by=sum
set multikmwan.global.auto_rank=0
set multikmwan.global.auto_bytes=10000000
set multikmwan.global.auto_margin=15
set multikmwan.global.st_streams=4
set multikmwan.global.busy_skip=1
set multikmwan.global.busy_mbps=20
set multikmwan.global.rank_mode=score
set multikmwan.global.score_w_speed=40
set multikmwan.global.score_w_web=25
set multikmwan.global.score_w_latency=20
set multikmwan.global.score_w_dns=15
set multikmwan.global.dns_url=https://cloudflare-dns.com/dns-query?name={name}&type=A
set multikmwan.global.web_timeout=10
add_list multikmwan.global.web_sites=https://www.facebook.com/
add_list multikmwan.global.web_sites=https://www.youtube.com/
add_list multikmwan.global.web_sites=https://drive.google.com/
add_list multikmwan.global.web_sites=https://www.reddit.com/
EOF
	uci commit multikmwan
fi

# Seed a ready-made server profile so the picker isn't empty. Independent of
# the global block above, so existing installs get it on upgrade too. Only
# runs when there are no server profiles yet; never clobbers your own.
if ! uci show multikmwan 2>/dev/null | grep -q '=server$'; then
	uci -q batch <<'EOF'
set multikmwan.cloudflare=server
set multikmwan.cloudflare.label=Cloudflare
set multikmwan.cloudflare.down_url=https://speed.cloudflare.com/__down?bytes={bytes}
set multikmwan.cloudflare.up_url=https://speed.cloudflare.com/__up
EOF
	uci commit multikmwan
fi

# A real-content profile: "speed test Facebook" pulls the site's own assets
# from its CDN. Seeded once, on new and existing installs alike, only if no
# profile with this id exists; it is not made the active server here.
if [ -z "$(uci -q get multikmwan.facebook)" ]; then
	uci -q batch <<'EOF'
set multikmwan.facebook=server
set multikmwan.facebook.label='Facebook (real content)'
set multikmwan.facebook.kind=page
set multikmwan.facebook.down_url=https://www.facebook.com/
EOF
	uci commit multikmwan
fi

exit 0
