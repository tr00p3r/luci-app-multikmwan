#!/bin/sh
. /usr/share/libubox/jshn.sh

SPEED_FILE=/tmp/multikmwan.speed
HEALTH_FILE=/tmp/multikmwan.health
GEO_FILE=/tmp/multikmwan.geo
SPEEDHIST_FILE=/tmp/multikmwan.speedhist
WEB_FILE=/tmp/multikmwan.web
WEBSITES_FILE=/tmp/multikmwan.websites
CONTENT_FILE=/tmp/multikmwan.content
PROGRESS_FILE=/tmp/multikmwan.progress
HIST_FILE=/etc/multikmwan/history.csv
AUTO_FILE=/tmp/multikmwan.autorank

# Same helper as in /usr/sbin/multikmwan: BusyBox flock has no -w timeout.
#   flock_wait <fd> <seconds> [-s]
flock_wait() {
	local fd="$1" secs="$2" mode="$3" i=0
	while ! flock -n $mode "$fd" 2>/dev/null; do
		i=$((i + 1))
		[ "$i" -lt "$secs" ] || return 1
		sleep 1
	done
}

# Stable per-WAN colour, assigned by IPv4 kmwan-member order so every page
# (cards, graphs, history) shows the same WAN in the same colour. Prints
# "<name> <hex>" per member.
mk_wan_palette() {
	local i=0 w hex
	for w in $(uci show kmwan 2>/dev/null | grep '=member' | cut -d. -f2 | cut -d= -f1); do
		[ "$(uci -q get kmwan.$w.addr_type)" = "4" ] || continue
		case $((i % 6)) in
			0) hex="#2a6fb5" ;; 1) hex="#1f8b4c" ;; 2) hex="#d9a400" ;;
			3) hex="#b3312c" ;; 4) hex="#7a4fb5" ;; 5) hex="#0f8b8b" ;;
		esac
		echo "$w $hex"
		i=$((i + 1))
	done
}

wans_json() {
	local pal
	pal=$(mk_wan_palette)
	local w st dev ifup uptime gw state ptx prx kmst rxb txb
	local rtt loss hep pubip isp city region country gep line oIFS base mode rf
	local rmode rb v sf sc sp dp wp spd dn wb dl ul ns tt ld ok tot h hc lp lt pk pw ps pi pn pe
	mode=$(uci -q get kmwan.global.mode)
	json_init
	json_add_string mode "${mode:-failover}"
	json_add_string enabled "$(uci -q get multikmwan.global.enabled)"
	json_add_int now "$(date +%s)"
	local interval
	interval=$(uci -q get multikmwan.global.interval)
	case "$interval" in ''|*[!0-9]*) interval=20 ;; esac
	[ "$interval" -ge 5 ] && [ "$interval" -le 3600 ] || interval=20
	json_add_int health_interval "$interval"
	local source_label source_profile source_down source_up source
	source=$(/usr/sbin/multikmwan test-source)
	IFS='|' read -r source_label source_profile source_down source_up <<EOF
$source
EOF
	json_add_object test_source
	json_add_string label "$source_label"
	json_add_string profile "$source_profile"
	json_add_string download_host "$source_down"
	json_add_string upload_host "$source_up"
	json_close_object

	# How "fastest" is decided, so the UI can explain the score it shows.
	# Defaults mirror the backend's g() fallbacks for unset options.
	json_add_object rank
	rmode=$(uci -q get multikmwan.global.rank_mode); json_add_string mode "${rmode:-score}"
	rb=$(uci -q get multikmwan.global.rank_by); json_add_string by "${rb:-sum}"
	v=$(uci -q get multikmwan.global.score_w_speed); json_add_string w_speed "${v:-40}"
	v=$(uci -q get multikmwan.global.score_w_web); json_add_string w_web "${v:-25}"
	v=$(uci -q get multikmwan.global.score_w_latency); json_add_string w_latency "${v:-20}"
	v=$(uci -q get multikmwan.global.score_w_dns); json_add_string w_dns "${v:-15}"
	json_close_object

	# A speed or website test in progress: what it is doing right now. The
	# file is rewritten at each step and removed at the end; a timestamp older
	# than ten minutes means a run died without cleaning up, so it is ignored.
	json_add_object testing
	pk=''; pw=''; ps=''; pi=''; pn=''; pe=''
	[ -f "$PROGRESS_FILE" ] && read -r pk pw ps pi pn pe < "$PROGRESS_FILE"
	if [ -n "$pk" ] && [ "$(( $(date +%s) - ${pe:-0} ))" -lt 600 ]; then
		json_add_boolean active 1
		json_add_string kind "$pk"; json_add_string wan "$pw"; json_add_string step "$ps"
		json_add_string index "$pi"; json_add_string total "$pn"; json_add_string since "$pe"
	else
		json_add_boolean active 0
	fi
	json_close_object

	json_add_object autorank
	json_add_string interval "$(uci -q get multikmwan.global.auto_rank)"
	json_add_string margin "$(uci -q get multikmwan.global.auto_margin)"
	if [ -f "$AUTO_FILE" ]; then
		set -- $(cat "$AUTO_FILE")
		json_add_string epoch "$1"; json_add_string decision "$2"; shift 2
		json_add_string order "$*"
	fi
	json_close_object

	json_add_array wans

	for w in $(uci show kmwan 2>/dev/null | grep '=member' | cut -d. -f2 | cut -d= -f1); do
		[ "$(uci -q get kmwan.$w.addr_type)" = "4" ] || continue
		st=$(ubus call network.interface.$w status 2>/dev/null)
		dev=$(echo "$st" | jsonfilter -q -e '@.l3_device')
		ifup=$(echo "$st" | jsonfilter -q -e '@.up')
		uptime=$(echo "$st" | jsonfilter -q -e '@.uptime')

		gw=$(ip route show table main 2>/dev/null | \
			awk -v d="$dev" '$1=="default" && $5==d {print $3; exit}')
		[ -n "$gw" ] || gw=$(ip route show table main 2>/dev/null | \
			awk -v d="$dev" '$1=="nexthop" && $5==d {print $3; exit}')

		# kmwan's own view. /proc/gl-kmwan/status columns:
		#  1 iface 2 netdev 3 ifindex 4 State 5 TrackMode 6 TX pkts 7 TX stamp 8 RX pkts 9 RX stamp
		line=$(grep -E "^$w[[:space:]]" /proc/gl-kmwan/status 2>/dev/null | head -1)
		state=$(echo "$line" | awk '{print $4}')
		ptx=$(echo "$line" | awk '{print $6}')
		prx=$(echo "$line" | awk '{print $8}')
		kmst=$(grep -E "^$w:" /proc/gl-kmwan/config 2>/dev/null | cut -d: -f2)

		rxb=$(cat /sys/class/net/$dev/statistics/rx_bytes 2>/dev/null)
		txb=$(cat /sys/class/net/$dev/statistics/tx_bytes 2>/dev/null)

		rtt=""; loss=""; hep=""
		if [ -f "$HEALTH_FILE" ]; then
			set -- $(grep "^$w " "$HEALTH_FILE" 2>/dev/null)
			rtt="$2"; loss="$3"; hep="$4"
		fi

		pubip=""; isp=""; city=""; region=""; country=""; gep=""
		if [ -f "$GEO_FILE" ]; then
			line=$(grep "^$w|" "$GEO_FILE" 2>/dev/null | head -1)
			if [ -n "$line" ]; then
				oIFS="$IFS"; IFS='|'; set -- $line; IFS="$oIFS"
				pubip="$2"; isp="$3"; city="$4"; region="$5"; country="$6"; gep="$7"
			fi
		fi

		json_add_object ""
		json_add_string name "$w"
		json_add_string color "$(echo "$pal" | awk -v w="$w" '$1==w{print $2}')"
		json_add_string device "$dev"
		json_add_string gateway "${gw:-}"
		json_add_string metric "$(uci -q get kmwan.$w.metric)"
		json_add_string weight "$(uci -q get kmwan.$w.weight)"
		json_add_string disabled "$(uci -q get kmwan.$w.disabled)"
		json_add_string metered "$(uci -q get multikmwan.$w.metered)"
		json_add_boolean link "$([ "$ifup" = "true" ] && echo 1 || echo 0)"
		json_add_int uptime "${uptime:-0}"
		json_add_boolean up "$([ -n "$gw" ] && echo 1 || echo 0)"
		json_add_string kmwan "${kmst:-}"
		json_add_string state "${state:-}"
		json_add_string probe_tx "${ptx:-}"
		json_add_string probe_rx "${prx:-}"
		json_add_string rtt "${rtt:-}"
		json_add_string loss "${loss:-}"
		json_add_string health_epoch "${hep:-}"
		json_add_string rx_bytes "${rxb:-0}"
		json_add_string tx_bytes "${txb:-0}"
		json_add_string pubip "${pubip:-}"
		json_add_string isp "${isp:-}"
		json_add_string city "${city:-}"
		json_add_string region "${region:-}"
		json_add_string country "${country:-}"
		json_add_string geo_epoch "${gep:-}"
		json_close_object
	done
	json_close_array

	# NB: no pipes into these loops. jshn keeps its state in shell variables,
	# and a `cmd | while read` body runs in a subshell whose json_add_* calls
	# are silently lost. Read from a redirect instead.
	json_add_array speed
	if [ -f "$SPEED_FILE" ]; then
		while read -r w d u st e; do
			[ -n "$w" ] || continue
			[ "${w#\#}" = "$w" ] || continue
			json_add_object ""
			json_add_string name "$w"
			json_add_string down "$d"
			json_add_string up "$u"
			json_add_string status "$st"
			json_add_string epoch "$e"
			json_close_object
		done < "$SPEED_FILE"
	fi
	json_close_array

	# Last website test: one summary row per WAN, then one row per site.
	json_add_array web
	if [ -f "$WEB_FILE" ]; then
		while read -r w dn tt ld ok tot st e; do
			[ -n "$w" ] || continue
			[ "${w#\#}" = "$w" ] || continue
			json_add_object ""
			json_add_string name "$w"
			json_add_string dns "$dn"
			json_add_string ttfb "$tt"
			json_add_string load "$ld"
			json_add_string ok "$ok"
			json_add_string total "$tot"
			json_add_string status "$st"
			json_add_string epoch "$e"
			json_close_object
		done < "$WEB_FILE"
	fi
	json_close_array

	json_add_array websites
	if [ -f "$WEBSITES_FILE" ]; then
		while read -r w h dn tt ld hc st e; do
			[ -n "$w" ] || continue
			[ "${w#\#}" = "$w" ] || continue
			json_add_object ""
			json_add_string name "$w"
			json_add_string host "$h"
			json_add_string dns "$dn"
			json_add_string ttfb "$tt"
			json_add_string load "$ld"
			json_add_string http "$hc"
			json_add_string status "$st"
			json_add_string epoch "$e"
			json_close_object
		done < "$WEBSITES_FILE"
	fi
	json_close_array

	# Real-content throughput per WAN for each "page" profile (Facebook...).
	json_add_array content
	if [ -f "$CONTENT_FILE" ]; then
		while read -r w p dl st h e; do
			[ -n "$w" ] || continue
			[ "${w#\#}" = "$w" ] || continue
			json_add_object ""
			json_add_string name "$w"
			json_add_string profile "$p"
			json_add_string label "$(uci -q get multikmwan."$p".label)"
			json_add_string down "$dl"
			json_add_string status "$st"
			json_add_string host "$h"
			json_add_string epoch "$e"
			json_close_object
		done < "$CONTENT_FILE"
	fi
	json_close_array

	# Composite ranking as the backend computes it, best first.
	json_add_array scores
	sf="/tmp/multikmwan.scores.$$"
	/usr/sbin/multikmwan score > "$sf" 2>/dev/null
	while read -r sc w sp dp wp spd dn wb dl ul ns lp lt; do
		[ -n "$w" ] || continue
		json_add_object ""
		json_add_string name "$w"
		json_add_string score "$sc"
		json_add_string speed_pts "$sp"
		json_add_string dns_pts "$dp"
		json_add_string web_pts "$wp"
		json_add_string speed "$spd"
		json_add_string dns "$dn"
		json_add_string web "$wb"
		json_add_string sites "$ns"
		json_add_string lat_pts "$lp"
		json_add_string latency "$lt"
		json_close_object
	done < "$sf"
	rm -f "$sf"
	json_close_array

	json_add_array rules
	base=$(uci -q get multikmwan.global.rule_base); [ -n "$base" ] || base=2000
	rf="/tmp/multikmwan.rules.$$"
	ip rule show 2>/dev/null | awk -F: -v lo="$base" -v hi="$((base+999))" 		'{pr=$1+0} pr>=lo && pr<=hi {sub(/^[0-9]+:[[:space:]]*/,""); print}' > "$rf"
	while read -r line; do
		[ -n "$line" ] || continue
		json_add_object ""
		json_add_string rule "$line"
		json_close_object
	done < "$rf"
	rm -f "$rf"
	json_close_array

	# Configured client rules (from config), each with whether it is currently
	# live (an ip rule exists for its source). Lets the UI show a device that
	# is set up but inactive because client preference is off.
	json_add_array clients
	local live_rules
	live_rules=$(ip rule show 2>/dev/null)
	for cs in $(uci show multikmwan 2>/dev/null | sed -n 's/^multikmwan\.\([^.]*\)=client$/\1/p'); do
		src=$(uci -q get multikmwan.$cs.src)
		[ -n "$src" ] || continue
		json_add_object ""
		json_add_string label "$(uci -q get multikmwan.$cs.label)"
		json_add_string src "$src"
		json_add_string mode "$(uci -q get multikmwan.$cs.mode)"
		json_add_string order "$(uci -q get multikmwan.$cs.order | tr '\n' ' ')"
		json_add_string enabled "$(uci -q get multikmwan.$cs.enabled)"
		json_add_boolean live "$(echo "$live_rules" | grep -q "from $src " && echo 1 || echo 0)"
		json_close_object
	done
	json_close_array

	# Ring of recent speed runs, for the status-page graph. Each line:
	#   epoch wan:down:up wan2:down:up ...
	json_add_array speedhist
	if [ -f "$SPEEDHIST_FILE" ]; then
		while read -r epoch rest; do
			[ -n "$epoch" ] || continue
			json_add_object ""
			json_add_string epoch "$epoch"
			json_add_array wans
			for tok in $rest; do
				json_add_object ""
				json_add_string name "${tok%%:*}"
				json_add_string down "$(echo "$tok" | cut -d: -f2)"
				json_add_string up "$(echo "$tok" | cut -d: -f3)"
				json_add_string epoch "$(echo "$tok" | cut -d: -f4)"
				json_close_object
			done
			json_close_array
			json_close_object
		done < "$SPEEDHIST_FILE"
	fi
	json_close_array
	test_history_fields 40
	json_dump
}

# Recorded profile labels and actual destination hosts, including redirects.
# The live file is replaced atomically; after reboot use the last checkpoint.
test_history_fields() {
	local file=/tmp/multikmwan-tests.csv ep wan dl ul result kind label profile dh uh ds us
	local limit="${1:-256}" snapshot="/tmp/multikmwan-tests-rpc.$$"
	[ -f "$file" ] || file=/etc/multikmwan/tests.csv
	json_add_array testhistory
	if [ -f "$file" ]; then
		tail -n "$limit" "$file" > "$snapshot"
		while IFS=, read -r ep wan dl ul result kind label profile dh uh ds us; do
			[ -n "$ep" ] || continue
			json_add_object ''
			json_add_string epoch "$ep"; json_add_string wan "$wan"
			json_add_string down "$dl"; json_add_string up "$ul"
			json_add_string status "$result"; json_add_string kind "$kind"
			json_add_string label "$label"; json_add_string profile "$profile"
			json_add_string download_host "$dh"; json_add_string upload_host "$uh"
			json_add_string download_status "$ds"; json_add_string upload_status "$us"
			json_close_object
		done < "$snapshot"
		rm -f "$snapshot"
	fi
	json_close_array
}

# 90-day daily history rolled into per-WAN summaries + day arrays for the
# History page. Reads the flat CSV (date,wan,up,down,rtt_sum,rtt_n,loss_sum,
# loss_n,outages,dl_sum,dl_n,dl_max,ul_sum,ul_n,ul_max).
history_json() (
	flock_wait 8 5 -s || { echo '{"error":"History is busy; retry shortly"}'; return; }
	local hf="/tmp/multikmwan.history-rpc.$$" pal
	trap 'rm -f "$hf"' EXIT
	cat "$HIST_FILE" /tmp/multikmwan.acc 2>/dev/null |
		awk -f /usr/share/multikmwan/history-merge.awk | sort > "$hf"
	# JSON formatting can be slow on small routers. Release after snapshot.
	flock -u 8
	pal=$(mk_wan_palette)
	json_init
	json_add_array days
	if [ -f "$hf" ]; then
		while IFS=, read -r date wan up down rs rn ls ln out ds dn dmax us un umax; do
			[ -n "$date" ] || continue
			json_add_object ""
			json_add_string date "$date"
			json_add_string wan "$wan"
			json_add_string color "$(echo "$pal" | awk -v w="$wan" '$1==w{print $2}')"
			json_add_int up "${up:-0}"
			json_add_int down "${down:-0}"
			json_add_int outages "${out:-0}"
			json_add_string rtt_avg "$(awk -v s="$rs" -v n="$rn" 'BEGIN{printf "%.1f", (n>0?s/n:0)}')"
			json_add_string loss_avg "$(awk -v s="$ls" -v n="$ln" 'BEGIN{printf "%.1f", (n>0?s/n:0)}')"
			json_add_string dl_avg "$(awk -v s="$ds" -v n="$dn" 'BEGIN{printf "%.1f", (n>0?s/n:0)}')"
			json_add_string dl_max "${dmax:-0}"
			json_add_string ul_avg "$(awk -v s="$us" -v n="$un" 'BEGIN{printf "%.1f", (n>0?s/n:0)}')"
			json_add_string ul_max "${umax:-0}"
			json_close_object
		done < "$hf"
	fi
	json_close_array
	test_history_fields
	json_dump
) 8>/var/lock/multikmwan-history.lock

quality_json() (
	local input hours
	read -r input
	json_load "$input" 2>/dev/null
	json_get_var hours hours
	[ "$hours" = 1 ] || hours=24
	flock_wait 9 2 -s || { echo '{"error":"Monitor is busy; retry shortly"}'; return; }
	local samples=/tmp/multikmwan-quality/samples events=/tmp/multikmwan-quality/events
	# Missing files are normal before the monitor's first pass.
	[ -f "$samples" ] || samples=/dev/null
	[ -f "$events" ] || events=/dev/null
	awk -v now="$(date +%s)" -v hours="$hours" -v samples="$samples" -v events="$events" \
		-f /usr/share/multikmwan/quality-json.awk "$samples" "$events"
) 9>/var/lock/multikmwan-quality.lock

# Known LAN hosts, so the UI can offer a picker instead of typed IPs.
# Static reservations come first - a dynamic lease can change address and
# silently stop matching the rule.
clients_json() {
	local i=0 mac ip name exp cid
	json_init
	json_add_array clients

	while [ $i -lt 128 ]; do
		mac=$(uci -q get dhcp.@host[$i].mac)
		[ -n "$mac" ] || break
		ip=$(uci -q get dhcp.@host[$i].ip)
		name=$(uci -q get dhcp.@host[$i].name)
		[ -n "$name" ] || name=$(uci -q get dhcp.@host[$i].tag)
		if [ -n "$ip" ]; then
			json_add_object ""
			json_add_string ip "$ip"
			json_add_string mac "$mac"
			json_add_string name "$name"
			json_add_boolean static 1
			json_close_object
		fi
		i=$((i + 1))
	done

	if [ -f /tmp/dhcp.leases ]; then
		while read -r exp mac ip name cid; do
			[ -n "$ip" ] || continue
			json_add_object ""
			json_add_string ip "$ip"
			json_add_string mac "$mac"
			json_add_string name "$name"
			json_add_boolean static 0
			json_close_object
		done < /tmp/dhcp.leases
	fi

	json_close_array
	json_dump
}

# Nearest speedtest.net (Ookla) servers, ready to add as profiles. Each speaks
# the classic HTTP protocol: download a random*.jpg, upload to upload.php.
stservers_json() {
	local list url base host i=0 n input q qe api
	read -r input
	json_load "$input" 2>/dev/null
	json_get_var q search
	api="https://www.speedtest.net/api/js/servers?engine=js&limit=25"
	if [ -n "$q" ]; then
		qe=$(echo "$q" | sed 's/ /%20/g')
		api="${api}&search=${qe}"
	fi
	list=$(curl -s --max-time 15 "$api" 2>/dev/null)
	json_init
	json_add_array servers
	while [ $i -lt 25 ]; do
		url=$(echo "$list" | jsonfilter -q -e "@[$i].url")
		[ -n "$url" ] || break
		# base = the server's /speedtest/ dir; download file lives there too
		base=${url%upload.php}
		json_add_object ""
		json_add_string id "$(echo "$list" | jsonfilter -q -e "@[$i].id")"
		json_add_string sponsor "$(echo "$list" | jsonfilter -q -e "@[$i].sponsor")"
		json_add_string name "$(echo "$list" | jsonfilter -q -e "@[$i].name")"
		json_add_string cc "$(echo "$list" | jsonfilter -q -e "@[$i].cc")"
		json_add_string dist "$(echo "$list" | jsonfilter -q -e "@[$i].distance")"
		json_add_string down "${base}random4000x4000.jpg"
		json_add_string up "$url"
		json_close_object
		i=$((i + 1))
	done
	json_close_array
	json_dump
}

case "$1" in
	list)
		json_init
		json_add_object "status";    json_close_object
		json_add_object "clients";   json_close_object
		json_add_object "history";   json_close_object
		json_add_object "quality"; json_add_string "hours" "int"; json_close_object
		json_add_object "stservers"; json_add_string "search" "str"; json_close_object
		json_add_object "add_server"; json_add_string "label" "str"; json_add_string "down" "str"; json_add_string "up" "str"; json_close_object
		json_add_object "sync";      json_close_object
		json_add_object "check";     json_close_object
		json_add_object "speedtest"; json_close_object
		json_add_object "webtest";   json_close_object
		json_add_object "health";    json_close_object
		json_add_object "geo";       json_close_object
		json_add_object "rank";      json_add_string "by" "str"; json_add_string "what" "str"; json_close_object
		json_add_object "setmode";   json_add_string "mode" "str"; json_close_object
		json_add_object "applymode"; json_close_object
		json_dump
		;;
	call)
		case "$2" in
			status)  wans_json ;;
			clients) clients_json ;;
			history) history_json ;;
			quality) quality_json ;;
			stservers) stservers_json ;;
			add_server)
				read -r input
				json_load "$input" 2>/dev/null
				json_get_var label label; json_get_var down down; json_get_var up up
				sid="st$(date +%s)"
				uci set multikmwan."$sid"=server
				uci set multikmwan."$sid".label="$label"
				uci set multikmwan."$sid".down_url="$down"
				[ -n "$up" ] && uci set multikmwan."$sid".up_url="$up"
				uci commit multikmwan
				json_init; json_add_string result "$sid"; json_dump ;;
			applymode)
				# Translate the committed mode_pref into kmwan settings, server-side
				# (reads the freshly-saved value, avoiding stale JS uci state).
				pref=$(uci -q get multikmwan.global.mode_pref); [ -n "$pref" ] || pref=failover
				case "$pref" in
					balancing) km=balancing ;;
					*) km=failover ;;
				esac
				uci set kmwan.global.mode="$km"
				if [ "$pref" = "fastest" ]; then
					ar=$(uci -q get multikmwan.global.auto_rank)
					{ [ -n "$ar" ] && [ "$ar" -gt 0 ] 2>/dev/null; } || uci set multikmwan.global.auto_rank=15
				fi
				uci commit kmwan
				uci commit multikmwan
				/etc/init.d/kmwan restart >/dev/null 2>&1
				json_init; json_add_string result "$pref"; json_dump ;;
			sync)
				json_init
				json_add_string result "$(/usr/sbin/multikmwan sync 2>&1 | tail -3)"
				json_dump ;;
			check)
				json_init
				json_add_string result "$(/usr/sbin/multikmwan check 2>&1)"
				json_dump ;;
			speedtest)
				(/usr/sbin/multikmwan speedtest >/dev/null 2>&1 &)
				json_init; json_add_string result "started"; json_dump ;;
			webtest)
				(/usr/sbin/multikmwan webtest >/dev/null 2>&1 &)
				json_init; json_add_string result "started"; json_dump ;;
			health)
				(/usr/sbin/multikmwan health >/dev/null 2>&1 &)
				json_init; json_add_string result "started"; json_dump ;;
			geo)
				(/usr/sbin/multikmwan geo force >/dev/null 2>&1 &)
				json_init; json_add_string result "started"; json_dump ;;
			rank)
				read -r input
				json_load "$input" 2>/dev/null
				json_get_var by by; json_get_var what what
				# No measure named: use the configured one, as auto-rank does.
				[ -n "$by" ] || by=$(uci -q get multikmwan.global.rank_by)
				[ -n "$by" ] || by=sum
				[ -n "$what" ] || what=both
				json_init
				json_add_string result "$(/usr/sbin/multikmwan rank "$by" "$what" 2>&1)"
				json_dump ;;
			setmode)
				read -r input
				json_load "$input" 2>/dev/null
				json_get_var mode mode
				json_init
				json_add_string result "$(/usr/sbin/multikmwan mode "$mode" 2>&1)"
				json_dump ;;
		esac
		;;
esac
